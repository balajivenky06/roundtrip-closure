# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Virtual environments ---
.venv/
venv/
env/
.envrc

# --- Secrets ---
.env
.env.local

# --- Build / install artefacts ---
*.egg-info/
build/
dist/
pip-wheel-metadata/

# --- Data + runtime outputs (large or non-reproducible) ---
data/*
!data/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
!results/.gitkeep
logs/*
!logs/.gitkeep
*.tsv
*.jsonl
*.parquet
*.pkl
*.pickle
*.pt

# Replication-package exceptions: files explicitly referenced in the paper's
# Data Availability statement. Real-initial annotator files remain blocked by
# the local human_eval/data/.gitignore.
!human_eval/data/annotator_A[123]_ratings.tsv
!human_eval/data/annotator_A[123]_uniform_ratings.tsv
!human_eval/data/annotator_E[12]_ratings.tsv
!human_eval/data/frontier_judge_*.tsv

# --- OS junk ---
.DS_Store
Thumbs.db
*.swp

# --- IDE ---
.vscode/
.idea/
*.code-workspace

# --- Plots / figures (regenerate from scripts) ---
# Track the Python source under plots/*.py but not the regenerated PNGs.
plots/output/
*.png
*.pdf
!docs/**/*.png
!docs/**/*.pdf
